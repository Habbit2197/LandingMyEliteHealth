---
interface Props { eyebrow?: string; title: string; lead?: string; center?: boolean; }
const { eyebrow, title, lead, center = false } = Astro.props;
---
<header class:list={['heading', center && 'heading-center']}>
  {eyebrow && <p class="eyebrow" data-reveal="up">{eyebrow}</p>}
  <h2 data-reveal="up" data-delay="60" set:html={title} />
  <!-- El texto de apoyo se arma palabra a palabra al entrar en pantalla.
       Solo aquí: es texto plano, así que partirlo no rompe nada. -->
  {lead && <p class="lead" data-split>{lead}</p>}
</header>
