---
import Base from './Base.astro';
import Footer from '../components/Footer.astro';
interface Props { title: string; lang?: 'es' | 'en'; }
const { title, lang = 'es' } = Astro.props;
const es = lang === 'es';
---
<Base title={`${title} · MyEliteHealth`} description={title} lang={lang}>
  <header class="nav nav-solid">
    <div class="wrap nav-inner">
      <a class="brand" href="/"><img src="/img/icono-padel.webp" alt="" width="34" height="34" /> MyEliteHealth</a>
      <a class="btn btn-ghost btn-sm" href="/">{es ? 'Volver a la web' : 'Back to the website'}</a>
    </div>
  </header>
  <main class="legal" id="contenido">
    <div class="wrap">
      <h1>{title}</h1>
      <slot />
    </div>
  </main>
  <Footer lang={lang} />
</Base>
